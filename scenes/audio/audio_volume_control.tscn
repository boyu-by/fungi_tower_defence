[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/audio/audio_volume_control.gd" id="1_volume"]

[node name="AudioVolume" type="HBoxContainer"]
process_mode = 3
custom_minimum_size = Vector2(290, 42)
theme_override_constants/separation = 10
script = ExtResource("1_volume")

[node name="Toggle" type="Button" parent="."]
custom_minimum_size = Vector2(80, 42)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "音效"

[node name="Volume" type="HSlider" parent="."]
custom_minimum_size = Vector2(130, 36)
layout_mode = 2
size_flags_horizontal = 3
step = 5.0
value = 70.0
tooltip_text = "音效音量"

[node name="Value" type="Label" parent="."]
custom_minimum_size = Vector2(50, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "70%"
horizontal_alignment = 2
vertical_alignment = 1
